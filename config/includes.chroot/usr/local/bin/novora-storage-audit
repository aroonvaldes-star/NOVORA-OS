#!/usr/bin/env python3
"""NOVORA OS — auditoría SOLO LECTURA de discos antes de instalar (v0.2).

No formatea, no particiona y no escribe en ningún disco. La única escritura
posible es el archivo JSON de autorización (--emit-allowlist), por defecto en
/run/novora (memoria, se pierde al apagar).

Códigos de salida: 0 = sin bloqueos, 1 = cancelado/uso, 2 = error de lsblk,
3 = selección BLOQUEADA.
"""
import argparse
import json
import os
import sys

sys.path.insert(0, "/usr/lib/novora")
sys.path.insert(0, os.environ.get("NOVORA_LIB", "/usr/lib/novora"))
import novora_storage as ns  # noqa: E402

DEFAULT_ALLOW = "/run/novora/allowlist.json"


def uefi_mode(args):
    if args.assume_uefi:
        return True
    if args.assume_bios:
        return False
    return os.path.isdir("/sys/firmware/efi")


def show(tree, uefi, show_serial):
    print("=== NOVORA OS | Auditoría de almacenamiento (SOLO LECTURA) ===")
    print("Este programa NUNCA formatea, particiona ni escribe en discos.\n")
    print("Arranque actual:", "UEFI" if uefi else "BIOS/Legacy")
    choices = []
    for d in ns.disks(tree):
        i = ns.identity(d)
        serial = i["serial"] if show_serial else ns.mask(i["serial"])
        live = "  [MEDIO LIVE]" if ns.is_live_medium(d) else ""
        print(f"\nDISCO {d.get('path')}: {i['model'] or 'sin modelo'} | "
              f"{ns.human(i['size'])} | serie={serial} | "
              f"wwn={'sí' if i['wwn'] else 'no'} | bus={i['tran'] or '?'} | "
              f"tabla={i['pttype'] or '?'} | sector={i['log_sec'] or '?'} B{live}")
        for p in ns.partitions(d):
            choices.append(p.get("path"))
            mnt = ns.mounted_anywhere(p)
            esp = " ESP" if ns.is_esp(p) else (" FAT32" if ns.is_fat_boot_candidate(d, p) else "")
            print(f"  [{len(choices)}] {p.get('path')} | {ns.human(p.get('size'))} | "
                  f"{p.get('fstype') or 'SIN FORMATO'}{esp} | "
                  f"montada={'sí' if mnt else 'no'}")
    return choices


def ask(choices, prompt):
    try:
        raw = input(prompt).strip()
        n = int(raw)
    except (ValueError, EOFError):
        return None
    if n < 1 or n > len(choices):
        return None
    return choices[n - 1]


def report(findings):
    order = {ns.BLOCK: 0, ns.WARN: 1, ns.INFO: 2}
    for level, code, msg in sorted(findings, key=lambda x: order[x[0]]):
        tag = {"BLOCK": "BLOQUEO", "WARN": "AVISO", "INFO": "INFO"}[level]
        print(f"  [{tag} {code}] {msg}")


def write_allow(path, allow):
    d = os.path.dirname(path)
    if d:
        os.makedirs(d, mode=0o700, exist_ok=True)
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(allow, fh, indent=2, ensure_ascii=False)
    os.replace(tmp, path)


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[1])
    ap.add_argument("--interactive", action="store_true")
    ap.add_argument("--target", help="partición raíz candidata (ruta actual)")
    ap.add_argument("--esp", help="ESP del MISMO disco externo")
    ap.add_argument("--esp-fat", action="store_true",
                    help="aceptar como ESP una FAT32 normal (0x0c) del mismo disco MBR")
    ap.add_argument("--emit-allowlist", nargs="?", const=DEFAULT_ALLOW,
                    help=f"escribir autorización JSON (defecto {DEFAULT_ALLOW})")
    ap.add_argument("--json", action="store_true", help="salida JSON")
    ap.add_argument("--show-serial", action="store_true",
                    help="mostrar serie completa (no compartir en informes)")
    ap.add_argument("--lsblk-json", help=argparse.SUPPRESS)
    g = ap.add_mutually_exclusive_group()
    g.add_argument("--assume-uefi", action="store_true", help=argparse.SUPPRESS)
    g.add_argument("--assume-bios", action="store_true", help=argparse.SUPPRESS)
    args = ap.parse_args(argv)

    try:
        tree = ns.load_tree(args.lsblk_json)
    except (ns.StorageError, ValueError, OSError) as ex:
        print("No se pudo consultar lsblk:", ex, file=sys.stderr)
        return 2
    uefi = uefi_mode(args)
    choices = [] if args.json else show(tree, uefi, args.show_serial)
    if args.json and not args.target:
        choices = [p.get("path") for d in ns.disks(tree) for p in ns.partitions(d)]

    target, esp = args.target, args.esp
    if args.interactive and not target:
        if not choices:
            print("\nNo hay particiones. No instalar.")
            return 1
        target = ask(choices, "\nNúmero de la partición RAÍZ candidata (0 cancela): ")
        if target is None:
            print("Cancelado.")
            return 1
        if uefi:
            esp = ask(choices, "Número de la ESP del MISMO disco externo (0 cancela): ")
            if esp is None:
                print("Cancelado.")
                return 1
    if not target:
        if not args.json:
            print("\nPara evaluar una selección SIN modificar nada:\n"
                  "  novora-storage-audit --interactive")
        return 0

    findings, allow = ns.evaluate(tree, target, esp, uefi, allow_fat_esp=args.esp_fat)
    if args.json:
        print(json.dumps({"target": target, "esp": esp, "uefi": uefi,
                          "findings": findings, "approved": allow is not None},
                         ensure_ascii=False, indent=2))
    else:
        print(f"\nEVALUACIÓN de raíz={target} esp={esp or '-'}:")
        report(findings)
    if allow is None:
        if not args.json:
            print("\nRESULTADO: BLOQUEADO. No se ha escrito ni modificado nada.")
        return 3
    if not args.json:
        print("\nRESULTADO: sin bloqueos. Revisa todos los AVISOS antes de seguir.")
    if args.emit_allowlist:
        write_allow(args.emit_allowlist, allow)
        if not args.json:
            print(f"Autorización escrita en {args.emit_allowlist} (solo memoria).")
    return 0


if __name__ == "__main__":
    sys.exit(main())
