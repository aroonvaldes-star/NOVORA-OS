#!/bin/sh
# shellcheck disable=SC1091  # build.conf lo genera build-iso.sh
# NOVORA OS — instala el motor de ATLAS (llama-server, paquete Debian
# llama.cpp-tools). Primero intenta trixie; si no hay candidato, trixie-backports;
# luego el binario oficial de ggml-org y, si GitHub Releases no responde, lo
# compila desde el código fuente (git, último tag bNNNN) con Vulkan.
# Si no se puede instalar, ATLAS queda instalado pero avisa "sin motor"
# (no rompe la ISO). NOVORA_ATLAS_ENGINE=required en
# /etc/novora-atlas/build.conf hace que la construcción falle en ese caso.
set -eu
chmod 0755 /usr/local/bin/novora-atlas /usr/local/bin/atlas
REQUIRED=optional
[ -f /etc/novora-atlas/build.conf ] && . /etc/novora-atlas/build.conf
REQUIRED="${NOVORA_ATLAS_ENGINE:-$REQUIRED}"

has_candidate() {
  apt-cache policy "$1" 2>/dev/null | grep -q 'Candidate: [0-9]'
}
installed=0
if has_candidate llama.cpp-tools; then
  apt-get install -y --no-install-recommends llama.cpp-tools && installed=1
else
  echo "ATLAS: llama.cpp-tools no está en trixie; probando trixie-backports"
  cat >/etc/apt/sources.list.d/novora-backports.sources <<'SRC'
Types: deb
URIs: http://deb.debian.org/debian
Suites: trixie-backports
Components: main contrib
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
SRC
  apt-get update
  if apt-get install -y --no-install-recommends -t trixie-backports llama.cpp-tools; then
    installed=1
  fi
fi
# Backend Vulkan de ggml (GPU sin controlador propietario, vía Mesa/NVK), si existe.
for pkg in libggml0-backend-vulkan libggml-backend-vulkan; do
  if has_candidate "$pkg"; then
    apt-get install -y --no-install-recommends "$pkg" || true
    break
  fi
done
# Descarga la última versión publicada de un proyecto de GitHub (asset por patrón)
# y la verifica contra la huella SHA256 que publica GitHub ("digest") si existe.
# Si la API no responde (límite de 60 consultas/hora por IP sin autenticar), usa
# la redirección pública /releases/latest y el nombre esperado del asset ($4).
fetch_release() {  # $1 repo, $2 regex del asset, $3 destino, $4 plantilla opcional ({tag})
  api=$(wget -q -O- "https://api.github.com/repos/$1/releases/latest") || api=""
  info=""
  if [ -n "$api" ]; then
    info=$(printf '%s' "$api" | python3 -c '
import json, re, sys
d = json.load(sys.stdin)
names = [a["name"] for a in d.get("assets", [])]
for a in d.get("assets", []):
    if re.search(sys.argv[1], a["name"]):
        dig = (a.get("digest") or "").removeprefix("sha256:") or "-"
        print(d["tag_name"], dig, a["browser_download_url"]); break
else:
    print("SIN-ASSET", d.get("tag_name", "?"), " ".join(names[:40]))' "$2") || info=""
  fi
  case "$info" in
    SIN-ASSET*)
      # Algunos proyectos marcan como «latest» una publicación sin binarios. Por
      # ejemplo llama.cpp: «latest» es v0.7.0 (solo nightly-tag.txt) y publica
      # cada compilación oficial bXXXX con prerelease: true (release-publish.yml).
      # Se toma la más reciente que trae el archivo, saltando solo borradores.
      echo "NOVORA: $1: «latest» (${info#SIN-ASSET }) no trae '$2'; busco en las publicaciones recientes"
      info=$(wget -q -O- "https://api.github.com/repos/$1/releases?per_page=30" | python3 -c '
import json, re, sys
for d in json.load(sys.stdin):
    if d.get("draft"):
        continue
    for a in d.get("assets", []):
        if re.search(sys.argv[1], a["name"]):
            dig = (a.get("digest") or "").removeprefix("sha256:") or "-"
            print(d["tag_name"], dig, a["browser_download_url"]); sys.exit()' "$2") || info=""
      [ -n "$info" ] || { echo "NOVORA AVISO: $1: ninguna publicación reciente trae '$2'"; return 1; }
      ;;
  esac
  if [ -z "$info" ]; then
    if [ -z "${4:-}" ]; then echo "NOVORA AVISO: $1: la API de GitHub no respondió (¿límite de consultas?)"; return 1; fi
    loc=$(wget -S --max-redirect=0 -O /dev/null "https://github.com/$1/releases/latest" 2>&1 | sed -n 's/^ *Location: //p' | tail -1)
    tag=${loc##*/}
    [ -n "$tag" ] || { echo "NOVORA AVISO: $1: no se pudo averiguar la última versión"; return 1; }
    name=$(printf '%s' "$4" | sed "s/{tag}/$tag/g")
    info="$tag - https://github.com/$1/releases/download/$tag/$name"
    echo "NOVORA: $1: API no disponible; uso la redirección pública ($tag)"
  fi
  tag=${info%% *}; rest=${info#* }; want=${rest%% *}; link=${rest#* }
  wget -q -O "$3" "$link" || { echo "NOVORA AVISO: $1 $tag: falló la descarga de $link"; return 1; }
  got=$(sha256sum "$3" | cut -d' ' -f1)
  if [ "$want" != "-" ] && [ "$want" != "$got" ]; then
    echo "NOVORA AVISO: $1 $tag: la huella SHA256 no coincide con la de GitHub; descartado."
    rm -f "$3"; return 1
  fi
  echo "NOVORA: $1 $tag sha256=$got (huella: $( [ "$want" = "-" ] && echo "NO verificada, GitHub no la dio" || echo "verificada con GitHub"))"
}
# Respaldo sin GitHub Releases: el código fuente por git (github.com por HTTPS)
# en el tag más reciente que cumpla el patrón; build.log anota el commit exacto.
git_latest_tag() {  # $1 repo, $2 regex ERE del tag completo
  git ls-remote --tags --refs "https://github.com/$1" 2>/dev/null \
    | sed 's#.*refs/tags/##' | grep -E "^($2)\$" | sort -V | tail -1
}
git_clone_tag() {  # $1 repo, $2 tag, $3 destino; resto: opciones de git clone
  r=$1; t=$2; d=$3; shift 3
  git clone -q --depth 1 "$@" --branch "$t" "https://github.com/$r" "$d" || return 1
  echo "NOVORA: $r $t desde el código fuente (commit $(git -C "$d" rev-parse HEAD))"
}
# Herramientas de compilación: build_deps_purge quita SOLO las que no estaban antes.
installed_pkgs() {
  dpkg-query -W -f='${db:Status-Abbrev} ${binary:Package}\n' | awk '$1 == "ii" {print $2}' | sort
}
build_deps_install() {
  installed_pkgs >/tmp/novora-pkgs-antes
  apt-get install -y --no-install-recommends "$@" || true
}
build_deps_purge() {
  nuevos=$(installed_pkgs | comm -13 /tmp/novora-pkgs-antes -)
  # shellcheck disable=SC2086  # lista de paquetes, uno por palabra
  [ -z "$nuevos" ] || apt-get purge -y $nuevos
  rm -f /tmp/novora-pkgs-antes
}
LLAMA=/usr/lib/novora/llama
# Deja llama-server de $LLAMA en el PATH y comprueba que arranca. $1: origen.
activate_llama() {
  cat >/usr/local/bin/llama-server <<'SH'
#!/bin/sh
# NOVORA OS: llama-server (ggml-org) con sus bibliotecas en /usr/lib/novora/llama
export LD_LIBRARY_PATH="/usr/lib/novora/llama${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec /usr/lib/novora/llama/llama-server "$@"
SH
  chmod 0755 /usr/local/bin/llama-server
  if /usr/local/bin/llama-server --version >/dev/null 2>&1; then
    installed=1
    echo "NOVORA: llama-server $1 instalado (Vulkan)."
  else
    echo "NOVORA AVISO: llama-server $1 no arranca; bibliotecas que faltan:"
    LD_LIBRARY_PATH=$LLAMA ldd "$LLAMA/llama-server" | grep "not found" || true
    rm -f /usr/local/bin/llama-server
  fi
}
# Respaldo: binario oficial de llama.cpp (ggml-org) con backend Vulkan, que usa
# la GPU con Mesa (Intel, AMD, NVK) o con el driver de NVIDIA, y si no hay GPU
# funciona en CPU. Se instala aparte en /usr/lib/novora/llama.
if [ "$installed" -ne 1 ]; then
  echo "ATLAS: llama.cpp-tools no está en Debian; probando el binario oficial de ggml-org/llama.cpp"
  apt-get install -y --no-install-recommends libvulkan1 libgomp1 || true
  tmp=$(mktemp -d)
  if fetch_release ggml-org/llama.cpp 'bin-ubuntu-vulkan-x64\.(zip|tar\.gz)$' "$tmp/llama.pkg" 'llama-{tag}-bin-ubuntu-vulkan-x64.tar.gz'; then
    rm -rf "$LLAMA"; mkdir -p "$LLAMA"
    if python3 - "$tmp/llama.pkg" "$LLAMA" <<'PY'
import os, shutil, sys, tarfile, tempfile, zipfile
pkg, dest = sys.argv[1], sys.argv[2]
work = tempfile.mkdtemp()
if zipfile.is_zipfile(pkg):
    with zipfile.ZipFile(pkg) as z:
        for m in z.namelist():                     # sin rutas absolutas ni ".."
            if m.startswith("/") or ".." in m.split("/"):
                sys.exit("ruta peligrosa en el paquete: " + m)
        z.extractall(work)
else:
    with tarfile.open(pkg) as t:
        t.extractall(work, filter="data")
srv = next((os.path.join(r, "llama-server") for r, _, f in os.walk(work) if "llama-server" in f), None)
if not srv:
    sys.exit("el paquete no trae llama-server")
src = os.path.dirname(srv)
for name in os.listdir(src):                       # binarios y bibliotecas de esa carpeta
    p = os.path.join(src, name)
    if os.path.isfile(p) and not os.path.islink(p) and (name.startswith("llama-") or ".so" in name):
        shutil.copy2(p, dest)
    elif os.path.islink(p) and ".so" in name:
        os.symlink(os.readlink(p), os.path.join(dest, name))
os.chmod(os.path.join(dest, "llama-server"), 0o755)
PY
    then
      activate_llama oficial
    fi
  fi
  rm -rf "$tmp"
fi
# Último respaldo, para redes que bloquean GitHub Releases pero no git: compilar
# llama-server desde el código fuente del último tag bNNNN (el mismo que
# publicaría el binario oficial) con Vulkan. Las herramientas de compilación
# que no estaban se purgan al terminar.
if [ "$installed" -ne 1 ]; then
  echo "ATLAS: probando compilar llama.cpp desde el código fuente (git)"
  tmp=$(mktemp -d)
  build_deps_install git ca-certificates cmake build-essential pkg-config libvulkan-dev glslc spirv-headers
  tag=$(git_latest_tag ggml-org/llama.cpp 'b[0-9]+')
  if [ -n "$tag" ] && git_clone_tag ggml-org/llama.cpp "$tag" "$tmp/src" \
     && cmake -S "$tmp/src" -B "$tmp/b" -DCMAKE_BUILD_TYPE=Release -DGGML_VULKAN=ON \
          -DGGML_NATIVE=OFF -DGGML_BACKEND_DL=OFF -DBUILD_SHARED_LIBS=ON -DLLAMA_CURL=OFF \
          -DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_EXAMPLES=OFF -DLLAMA_BUILD_SERVER=ON >/dev/null \
     && cmake --build "$tmp/b" -j"$(nproc)" --target llama-server >/dev/null; then
    rm -rf "$LLAMA"; mkdir -p "$LLAMA"
    cp -a "$tmp/b/bin/llama-server" "$LLAMA/"
    find "$tmp/b/bin" -maxdepth 1 -name '*.so*' -exec cp -a {} "$LLAMA/" \;
    find "$LLAMA" -type f -exec strip --strip-unneeded {} + 2>/dev/null || true
    activate_llama "compilado ($tag)"
  else
    echo "NOVORA AVISO: ggml-org/llama.cpp: no se pudo compilar desde el código fuente."
  fi
  build_deps_purge
  rm -rf "$tmp"
fi
if [ "$installed" -ne 1 ]; then
  echo "NOVORA AVISO: no se pudo instalar llama.cpp-tools; ATLAS funcionará sin motor."
  [ "$REQUIRED" = "required" ] && exit 1
fi
# Office Oxide (MIT/Apache-2.0): ATLAS lee .docx/.xlsx/.pptx sin internet.
VENDOR=/usr/lib/novora/atlas/vendor
mkdir -p "$VENDOR"
if python3 -m pip install --quiet --no-cache-dir --target "$VENDOR" office-oxide; then
  ver=$(python3 -c "import sys; sys.path.insert(0, '$VENDOR'); import importlib.metadata as m; print(m.version('office-oxide'))" 2>/dev/null || echo '?')
  echo "NOVORA ATLAS: Office Oxide $ver instalado."
else
  echo "NOVORA AVISO: no se pudo instalar Office Oxide; ATLAS no leerá documentos de Office."
fi
if command -v llama-server >/dev/null; then
  echo "ATLAS: $(llama-server --version 2>&1 | head -1)"
fi
if ls /usr/share/novora-atlas/models/*.gguf >/dev/null 2>&1; then
  echo "ATLAS: modelos incluidos en la ISO:"
  ls -la /usr/share/novora-atlas/models/
else
  echo "ATLAS: la ISO no incluye modelo (se instala luego con 'novora-atlas modelo instalar')."
fi
