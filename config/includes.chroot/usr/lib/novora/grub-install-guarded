#!/bin/sh
# NOVORA OS — envoltorio de grub-install para Calamares (se ejecuta dentro del
# chroot del sistema destino). Fail-closed:
#   * solo UEFI x86_64 (un GRUB BIOS escribiría en el MBR de un disco);
#   * la ESP y la raíz deben estar en el MISMO disco físico y ser escribibles;
#   * añade --no-nvram (no crea/reordena entradas del firmware: protege el
#     orden de arranque de Windows y evita disparar la recuperación BitLocker);
#   * añade --force-extra-removable (opción de Debian) para dejar también
#     EFI/BOOT/BOOTX64.EFI y poder arrancar el disco externo desde el menú
#     de arranque del firmware sin entrada NVRAM.
set -eu
REAL="${NOVORA_REAL_GRUB_INSTALL:-/usr/sbin/grub-install}"
FINDMNT="${NOVORA_FINDMNT:-findmnt}"
LSBLK="${NOVORA_LSBLK:-lsblk}"
SYSBLOCK="${NOVORA_SYSBLOCK:-/sys/class/block}"
die() { echo "NOVORA grub-install-guarded: CANCELADO: $*" >&2; exit 1; }

target=''; efidir=''; prev=''
for a in "$@"; do
  case "$prev" in
    --target) target="$a" ;;
    --efi-directory) efidir="$a" ;;
  esac
  case "$a" in
    --target=*) target="${a#--target=}" ;;
    --efi-directory=*) efidir="${a#--efi-directory=}" ;;
    /dev/*) die "no se permite instalar en un dispositivo de bloque ($a)" ;;
  esac
  prev="$a"
done
[ "$target" = "x86_64-efi" ] || die "destino '$target' no permitido (solo x86_64-efi)"
[ -n "$efidir" ] || die "falta --efi-directory"

esp_src=$("$FINDMNT" -no SOURCE --mountpoint "$efidir") || die "la ESP no está montada en $efidir"
root_src=$("$FINDMNT" -no SOURCE --mountpoint /) || die "no se pudo determinar la raíz"
esp_fs=$("$LSBLK" -dno FSTYPE "$esp_src")
[ "$esp_fs" = "vfat" ] || die "la ESP ($esp_src) no es vfat"
# Cadena hacia abajo de cada dispositivo (la raíz puede ser LUKS:
# dm-0 crypt → sdb3 part → sdb disk). Disco = el último de tipo disk.
chain() { "$LSBLK" -nsro KNAME,TYPE "$1"; }
disk_of() { chain "$1" | awk '$2 == "disk" { d = $1 } END { print d }'; }
esp_disk=$(disk_of "$esp_src")
root_disk=$(disk_of "$root_src")
if [ -z "$esp_disk" ] || [ "$esp_disk" != "$root_disk" ]; then
  die "ESP ($esp_src, disco ${esp_disk:-?}) y raíz ($root_src, disco ${root_disk:-?}) en discos distintos"
fi
for dev in "$esp_src" "$root_src"; do
  # Todo lo que hay entre el sistema de archivos y el disco debe estar
  # desbloqueado por el guardián (ro=0); si no, no es el destino autorizado.
  knames=$(chain "$dev" | awk '$2 != "disk" { print $1 }')
  [ -n "$knames" ] || die "no se pudo determinar la cadena de $dev"
  for kname in $knames; do
    ro=$(cat "$SYSBLOCK/$kname/ro" 2>/dev/null || echo '?')
    [ "$ro" = "0" ] || die "$dev ($kname) no es escribible (ro=$ro): no es el destino autorizado"
  done
done

case " $* " in *" --no-nvram "*) extra='' ;; *) extra='--no-nvram' ;; esac
case " $* " in *" --force-extra-removable "*) ;; *) extra="$extra --force-extra-removable" ;; esac
# shellcheck disable=SC2086  # $extra contiene opciones separadas a propósito
exec "$REAL" "$@" $extra
